{
  "expo": {
    "name": "Easel",
    "slug": "easel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "easel",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/ios-icon-dark.png",
        "tinted": "./assets/images/ios-icon-tinted.png"
      },
      "bundleIdentifier": "dev.badbird.easel",
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "rldb"
        ],
        "CFBundleLocalizations": [
          "en",
          "fr",
          "ar"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F63E0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "dev.evanyu.easel",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidConfigChanges",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F3F4F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112,
          "dark": {
            "backgroundColor": "#09090B",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "activationRule": {
              "supportsFileWithMaxCount": 10,
              "supportsImageWithMaxCount": 10,
              "supportsMovieWithMaxCount": 5,
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "*/*"
            ],
            "multipleShareMimeTypes": [
              "*/*"
            ]
          }
        }
      ],
      "expo-video",
      "expo-background-task",
      [
        "expo-audio",
        {
          "microphonePermission": "Easel records audio when you add a recording to a submission, comment, or message, or a course tool asks for it."
        }
      ],
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": false,
          "supportedLocales": [
            "en",
            "fr",
            "ar"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3D4FE0",
          "defaultChannel": "reminders",
          "icon": "./assets/images/notification-icon.png"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Easel uses the camera when you take a photo, scan a document, record a video to submit, or a course tool asks for it.",
          "microphonePermission": "Easel records audio when you add a recording to a submission, comment, or message, or a course tool asks for it.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Easel opens your photos when you choose one to submit, attach, or upload."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Easel saves images and videos you download to your photo library.",
          "savePhotosPermission": "Easel saves images and videos you download to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Easel adds your Canvas calendar to the calendars on this device when you ask it to."
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "NextDueWidget",
              "displayName": "Next due",
              "description": "Your next deadline and what's left this week.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular",
                  "accessoryInline"
                ],
                "initialLayout": "src/features/widgets/layouts.ios.tsx"
              },
              "android": {
                "initialLayout": "src/features/widgets/layouts.android.tsx",
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "minWidth": 110,
                "minHeight": 110
              }
            },
            {
              "name": "TodoWidget",
              "displayName": "To Do",
              "description": "What's due today and tomorrow.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "src/features/widgets/layouts.ios.tsx"
              },
              "android": {
                "initialLayout": "src/features/widgets/layouts.android.tsx",
                "targetCellWidth": 4,
                "targetCellHeight": 3,
                "minWidth": 250,
                "minHeight": 180
              }
            },
            {
              "name": "AnnouncementsWidget",
              "displayName": "Announcements",
              "description": "The latest announcements from your courses.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "src/features/widgets/layouts.ios.tsx"
              },
              "android": {
                "initialLayout": "src/features/widgets/layouts.android.tsx",
                "targetCellWidth": 4,
                "targetCellHeight": 3,
                "minWidth": 250,
                "minHeight": 180
              }
            },
            {
              "name": "GradesWidget",
              "displayName": "Grades",
              "description": "Current grades in your courses.",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ],
                "initialLayout": "src/features/widgets/layouts.ios.tsx"
              },
              "android": {
                "initialLayout": "src/features/widgets/layouts.android.tsx",
                "targetCellWidth": 4,
                "targetCellHeight": 3,
                "minWidth": 250,
                "minHeight": 180
              }
            }
          ]
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "dev.badbird.easel.expo-sharing-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.dev.badbird.easel"
                    ]
                  }
                },
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "dev.badbird.easel.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.dev.badbird.easel"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "377a9eb4-3d50-4ecd-a2e9-9ebdcf7e75a1"
      },
      "supportsRTL": true,
      "forcesRTL": false
    },
    "owner": "badbird5907",
    "updates": {
      "url": "https://u.expo.dev/377a9eb4-3d50-4ecd-a2e9-9ebdcf7e75a1",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
